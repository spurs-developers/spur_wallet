# Spurs Wallet — environment
NODE_ENV=production
# Public wallet origin used for SSO return URLs and login redirects.
APP_URL=https://wallet.spurs.com.ng

# Shared Spurs Neon Postgres (Wallet uses its own `wallet` schema)
DATABASE_SYNC_URL="postgresql://neondb_owner:npg_dOg7JeVM9Kaw@ep-fancy-brook-apiel7gd.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Shared secret for private service-to-service calls (must match pay + baas + accounts)
INTERNAL_API_SECRET="123-76-43334-5-433-45-65665-ghfgdfv-s-6543-2v-bvc-vwe-56"

# Spurs Pay — Wallet funds top-ups through the gateway's private API
PAY_INTERNAL_URL=http://localhost:3100

# Session signing (Wallet's own SSO session cookie)
JWT_SECRET="abcdefghijklmnopqrstuvwxyz012345"

# Spurs SSO — shared session cookie via @spurs-cloud/accounts.
# No per-app OIDC client any more: accounts issues one cookie for every app.
SPURS_ISSUER=https://accounts.spurs.com.ng
SPURS_SESSION_SECRET="abcdefghijklmnopqrstuvwxyz012345"

# Read config/credentials from the Spurs admin control plane
SPURS_ADMIN_URL="http://127.0.0.1:3300"
SPURS_ADMIN_APP="wallet"
SPURS_ADMIN_SECRET="spurs-admin-bootstrap-secret-change-me"
